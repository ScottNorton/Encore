+	 * controller to ignore suspend and stay live; RESET_EN still re-inits ep0
+	 * cleanly when the host resumes. */
 	usbintr = USBINTR_INT_EN | USBINTR_ERR_INT_EN
 		| USBINTR_PORT_CHANGE_DETECT_EN
-		| USBINTR_RESET_EN | USBINTR_DEVICE_SUSPEND;
+		| USBINTR_RESET_EN;
