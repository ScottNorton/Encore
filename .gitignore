# USB boot (user downloads OTA2 contents)
uboot/*
!uboot/README.md

# Build outputs
/build/
firmware/83_IMAGE
firmware/83_IMAGE_stock
firmware/*.squashfs
firmware/dsp_test/
flash/83_IMAGE
buildroot/
rootfs/usr/bin/encore
branding-kit/

# Downloaded/built artifacts (not source)
firmware/*.cpio.gz
firmware/initramfs/
firmware/initramfs_tiny/
firmware/kernel_test/
firmware/wifi_firmware/

# Third-party build tools (upstream sources, kept locally only)
tools/*
# Carve out user-authored C sources that accompany tracked binaries in rootfs/
!tools/i2c_mute.c
!tools/i2c_diag.c

# Local-only / experimental device scripts (underscore-prefix convention).
# These often contain copies of stock proprietary binaries, one-off
# strace/debug captures, or throwaway deployment helpers.
scripts/device/_*

# Design docs and local tools
docs/plans/
docs/serve.bat

# Vendor (RE reference material — not part of the release)
vendor/

# Worktrees
.worktrees/

# OS / editor
.DS_Store
Thumbs.db
NUL
*.swp
*.swo
*~
.vscode/
.idea/

# Tool config
.claude/
.superpowers/
CLAUDE.md
.aider.conventions.md

# Python
__pycache__/
*.pyc

# Rust compiler/clippy crash dumps (generated on an ICE)
rustc-ice-*.txt

# GitHub publish workflow
.github-publish

# Verify patterns (personal credentials — never commit)
.verify-patterns

# Local device / SSH overrides (device IP, SSH password). See .encore-env.example.
.encore-env

# Credentials (should never exist, but just in case)
spotify_client_id.txt
*.env
*.keystore
.aider*

# TLS keys and certificates. The firmware build creates its fallback pair in
# build/tls/ (covered by /build/ above); a private key must never be committed.
*.pem
*.key
*.p12
*.pfx
*.jks

# Vendor manuals and datasheets are not redistributed. Link to the vendor instead.
*.pdf

# librespot-audio is vendored + patched (upstream PR #1722) and MUST be tracked
# despite the vendor/ rule above; the [patch.crates-io] in encore/Cargo.toml needs it.
!encore/vendor/
!encore/vendor/librespot-audio/**
