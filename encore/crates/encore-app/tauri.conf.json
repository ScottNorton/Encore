{
  "productName": "Encore",
  "version": "0.1.0",
  "identifier": "com.encore.speaker",
  "build": {
    "frontendDist": "../../../build/app-dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Encore",
        "width": 420,
        "height": 800,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
